ENVIRONMENT=production
PUBLIC_BASE_URL=https://schedule.connorodea.com
PAGE_OWNER_NAME=Connor O'Dea
OWNER_TIMEZONE=America/Denver

# Monday-Friday, 10:30 AM-8:00 PM Denver time.
AVAILABILITY_START=10:30
AVAILABILITY_END=20:00
AVAILABILITY_WEEKDAYS=0,1,2,3,4
SLOT_INCREMENT_MINUTES=15
MINIMUM_NOTICE_HOURS=12
BOOKING_WINDOW_DAYS=60
BUFFER_BEFORE_MINUTES=10
BUFFER_AFTER_MINUTES=10

VIDEO_DURATION_MINUTES=30
PHONE_DURATION_MINUTES=20
VIDEO_PROVIDER=zoom

GOOGLE_OAUTH_TOKEN_FILE=/run/secrets/google-token
GOOGLE_BUSY_CALENDAR_IDS=primary
GOOGLE_BOOKING_CALENDAR_ID=primary

PYICLOUD_ENABLED=true
PYICLOUD_APPLE_ID=
PYICLOUD_PASSWORD_FILE=/run/secrets/icloud-password
PYICLOUD_COOKIE_DIRECTORY=/data/pyicloud
PYICLOUD_CHINA_MAINLAND=false

# Optional read-only calendar feeds, separated by commas. HTTPS only.
ICS_CALENDAR_URLS=
ICS_REQUEST_TIMEOUT_SECONDS=10

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET_FILE=/run/secrets/zoom-client-secret
# The Zoom host user's email or user ID (required for Server-to-Server OAuth).
ZOOM_USER_ID=

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=30
ALLOWED_HOSTS=schedule.connorodea.com,localhost,127.0.0.1
TRUST_PROXY_HEADERS=true

# Optional Cloudflare Turnstile. Mount the secret and add it to Compose first.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_FILE=
TURNSTILE_REQUIRED=false
